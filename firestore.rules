rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global primitive definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validation Helpers ---

    function isValidGuruProfile(data) {
      return data.nama is string && data.nama.size() <= 200 &&
             data.mapel is string && data.mapel.size() <= 100 &&
             data.jenjang is string && data.jenjang.size() <= 50 &&
             data.kurikulum is string && data.kurikulum.size() <= 50;
    }

    function isValidKontenGuru(data) {
      return data.guru_id is string && data.guru_id == request.auth.uid &&
             data.tipe is string && data.tipe.size() <= 50 &&
             data.topik is string && data.topik.size() <= 200 &&
             data.konten is string && data.konten.size() <= 100000;
    }

    function isValidMarketplaceItem(data) {
      return data.original_guru_id is string && data.original_guru_id == request.auth.uid &&
             data.judul is string && data.judul.size() <= 200 &&
             data.konten is string && data.konten.size() <= 100000;
    }

    function isValidKelasData(data) {
      return data.guru_id is string && data.guru_id == request.auth.uid &&
             data.kelas_id is string && data.kelas_id.size() <= 100 &&
             data.nama_kelas is string && data.nama_kelas.size() <= 100;
    }

    // --- Path Rules ---

    match /guru_profiles/{guruId} {
      allow get: if isOwner(guruId);
      allow create: if isOwner(guruId) && isValidGuruProfile(incoming());
      allow update: if isOwner(guruId) && isValidGuruProfile(incoming()) && (
        incoming().nama == existing().nama || incoming().diff(existing()).affectedKeys().hasAny(['mapel', 'jenjang', 'kelas', 'kurikulum', 'sekolah', 'kota_provinsi', 'gaya_mengajar', 'preferensi_konten', 'standar_kualitas', 'histori_pembelajaran'])
      );
      allow delete: if isOwner(guruId);
    }

    match /konten_guru/{kontenId} {
      allow get: if isSignedIn() && existing().guru_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.guru_id == request.auth.uid;
      allow create: if isSignedIn() && isValidKontenGuru(incoming());
      allow update: if isSignedIn() && existing().guru_id == request.auth.uid && isValidKontenGuru(incoming());
      allow delete: if isSignedIn() && existing().guru_id == request.auth.uid;
    }

    match /marketplace/{kontenId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidMarketplaceItem(incoming());
      allow update: if isSignedIn() && existing().original_guru_id == request.auth.uid && isValidMarketplaceItem(incoming());
      allow delete: if isSignedIn() && existing().original_guru_id == request.auth.uid;
    }

    match /kelas_data/{kelasId} {
      allow get: if isSignedIn() && existing().guru_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.guru_id == request.auth.uid;
      allow create: if isSignedIn() && isValidKelasData(incoming());
      allow update: if isSignedIn() && existing().guru_id == request.auth.uid && isValidKelasData(incoming());
      allow delete: if isSignedIn() && existing().guru_id == request.auth.uid;
    }
  }
}
